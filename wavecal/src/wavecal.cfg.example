wavecal_control:
{
   xtol = 1.e-8;    # parameter convergence criterion
   ftol = 1.e-8;    # objective function convergence criterion
   maxiter = 200;   # max number of Levenberg-Marquardt iterations

   sza_max = 80.0;  # Radiance spectra with sza > sza_max will not be calibrated

   shift_adjust_table = "$SDPC_REFDATA_DIR/instrument/wavecal_adjust_20190124.nc";
};

band_290_490_nm:
{
  # [optional] specify narrow window to fit (default is full-band)
  *feature_window:
  {
     start_pix = 495;
     num_pix_fit = 60;
     delta_wavelength = 0.2;    # bin width [nm]
     fid_wavelength = 393.3;    # reference point wavelength [nm]
  };

  wavecal_irradiance:
  {
    # Wavelength grid parameterization:
    method = "cheb"; num_coef = 7;

    # Reference solar spectrum for wavelength calibration:
    data:
    {
       value = "SolarIrradiance";
       wavegrid = "Wavelength";
       path = "$SDPC_REFDATA_DIR/instrument/wavcal_refspec_TEMPO_ILS.nc";
       scale_factor = 1.0e-14;
    };
  };

  wavecal_radiance:
  {
   # The radiance model has the form:
   #  model = sc*(i0 + ad1)*exp(-lbe) + bl + ad2
   #
   # Each component listed here contributes to a single
   # term which must be one of: {sc, ad1, ad2, lbe, bl}.
   #
   # To omit a component from the fit, prefix the
   # corresponding section label with an asterisk (*).

   AlbSC:
   {
     term = "sc";
     method = "cspline";
     # scale_by_mean_radiance_over_mean_irradiance = true;
     function:
     {
           nodes = [285.0, 302.5, 320.0, 337.5, 355.0,
                    372.5, 390.0, 407.5, 425.0, 442.5,
                    460.0, 477.5, 495.0];
           x0 = [390.0];
           y0 = [0.05];
     };
   };

   *BLine:
   {
     term = "bl";
     method = "poly"; num_coef = 2; xexp = 390.0;
     function:
     {
         x0 = [390.0];
         y0 = [0.0];
     };
   };

   RING:
   {
     term = "ad1";
     method = "cspline";
     function:
     {
           nodes = [285.0,295.0,300.0,310.0,320.0,330.0,340.0,415.0,495.0];
           x0 = [390.0];
           y0 = [-1.0];
     };
     data:
     {
           value = "RING";
           wavegrid = "Wavelength";
           path = "$SDPC_REFDATA_DIR/instrument/wavcal_refspec_TEMPO_ILS.nc";
     };
   };

   *O3_220K:
   {
     term = "lbe";
     method = "cspline";
     function:
     {
           nodes = [285.0,295.0,300.0,305.0,310.0,315.0,340.0,495.0];
           x0 = [390.0];
           y0 = [0.0];
     };
     data:
     {
           value = "O3_220K";
           wavegrid = "Wavelength";
           path = "$SDPC_REFDATA_DIR/instrument/wavcal_refspec_TEMPO_ILS.nc";
           scale_factor = 1.0e22;
     };
   };
  };
};   # end of band_290_490_nm

band_540_740_nm:
{
  # [optional] specify narrow window to fit (default is full-band)
  *feature_window:
  {
     start_pix = 495;
     num_pix_fit = 60;
     delta_wavelength = 0.2;    # bin width [nm]
     fid_wavelength = 393.3;    # reference point wavelength [nm]
  };

  wavecal_irradiance:
  {
    # Wavelength grid parameterization:
    method = "cheb"; num_coef = 7;

    # Reference solar spectrum for wavelength calibration:
    data:
    {
       value = "SolarIrradiance";
       wavegrid = "Wavelength";
       path = "$SDPC_REFDATA_DIR/instrument/wavcal_refspec_TEMPO_ILS_Band2.nc";
       scale_factor = 1.0e-14;
    };
  };

  wavecal_radiance:
  {
   # The radiance model has the form:
   #  model = sc*(i0 + ad1)*exp(-lbe) + bl + ad2
   #
   # Each component listed here contributes to a single
   # term which must be one of: {sc, ad1, ad2, lbe, bl}.
   #
   # To omit a component from the fit, prefix the
   # corresponding section label with an asterisk (*).

   AlbSC:
   {
     term = "sc";
     method = "cspline";
     function:
     {
           nodes = [535.0, 550.0, 565.0, 580.0, 595.0,
                    610.0, 625.0, 640.0, 655.0, 670.0,
                    685.0, 700.0, 715.0, 730.0, 745.0];
           x0 = [390.0];
           y0 = [0.05];
     };
   };

   *BLine:
   {
     term = "bl";
     method = "poly"; num_coef = 2; xexp = 640.0;
     function:
     {
         x0 = [640.0];
         y0 = [0.0];
     };
   };

   H2O_285K:
   {
     term = "lbe";
     method = "positive_coeff";
     function:
     {
           nodes = [535.0, 750.0];
           x0 = [640.0];
           y0 = [1.0];
     };
     data:
     {
           value = "H2O_285K_875hPa";
           wavegrid = "Wavelength";
           path = "$SDPC_REFDATA_DIR/instrument/wavcal_refspec_TEMPO_ILS_Band2.nc";
           scale_factor = 1.0e24;
     };
   };

   O2_285K:
   {
     term = "lbe";
     method = "positive_coeff";
     function:
     {
           nodes = [535.0, 750.0];
           x0 = [640.0];
           y0 = [1.0];
     };
     data:
     {
           value = "O2_285K_875hPa";
           wavegrid = "Wavelength";
           path = "$SDPC_REFDATA_DIR/instrument/wavcal_refspec_TEMPO_ILS_Band2.nc";
           scale_factor = 1.0e24;
     };
   };
  };
};  # end of band_540_740_nm
