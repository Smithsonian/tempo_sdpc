!!
!! @dim@-D tables
!!
  subroutine ndi_table_@typchar@@dim@d_interp (dims, tbl, x, val, errstat, input_indices, output_indices, fill_value)
    implicit none
    integer, parameter :: nd=@dim@, nterms=2**nd
    type (ndi_dim), intent(in), dimension(:) :: dims
    real (kind=@fkind@), intent(in), dimension(@colons@) :: tbl
    real (kind=r8), dimension(nd), intent(in) :: x
    real (kind=@fkind@), intent(out) :: val
    integer, intent(inout) :: errstat
    integer, optional, dimension(nd), intent(in) :: input_indices
    integer, optional, dimension(nd), intent(out) :: output_indices
    real (kind=@fkind@), optional, intent(in) :: fill_value

    real (kind=r8), dimension(nd) :: weights
    integer, dimension(nd) :: indices, id_k
    real (kind=r8) :: wt_k, val_r8, wt_sum
    real (kind=@fkind@) :: val_k
    integer :: k

    if (errstat /= 0) return

    if (present(input_indices)) then
      indices = input_indices
    else
      call ndi_find_indices (dims, x, indices, errstat)
      if (errstat /= 0) return
      if (present(output_indices)) output_indices = indices
    endif

    call ndi_calc_weights (dims, x, indices, weights, errstat)
    if (errstat /= 0) return

    val_r8 = 0.0
    if (present(fill_value)) then
       wt_sum = 0.0
       do k = 1, nterms
         call ndi_calc_term_weight (k, indices, weights, id_k, wt_k)
         val_k = tbl(@idxid@)
         if (val_k /= fill_value) then
            val_r8 = val_r8 + wt_k * val_k
            wt_sum = wt_sum + wt_k
         endif
       enddo
       if (wt_sum /= 0.0) then
          val = real (val_r8/wt_sum, kind=@fkind@)
       else
          val = fill_value
       endif
    else
       do k = 1, nterms
         call ndi_calc_term_weight (k, indices, weights, id_k, wt_k)
         val_r8 = val_r8 + wt_k * tbl(@idxid@)
       enddo
       val = real (val_r8, kind=@fkind@)
    endif

  end subroutine ndi_table_@typchar@@dim@d_interp
