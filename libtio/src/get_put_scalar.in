!
!> @ioaction@ a scalar variable of type @ftype@ (kind=@fkind@) as type @ntype@
  subroutine tiof_@action@_@type@ (obj, name, value, errstat)
    implicit none
    type (tiof_file_type), intent(in) :: obj
    character (len=*), intent(in) :: name
    @ftype@ (kind=@fkind@), intent(@intent@) :: value
    integer, intent(inout) :: errstat

    integer :: err, start=0, edge=0

    if (errstat < 0) return

    err = tiof_@action@_var_section (obj % groupid, name, start, edge, &
                                     @ntype@, value)
    if (err < 0) then
      call tell_error (tell_io_@ioaction@_error, "Unable to @ioaction@ " // &
                       trim(name) // " @iodir@ file", errstat)
      return
    endif
  end subroutine tiof_@action@_@type@
