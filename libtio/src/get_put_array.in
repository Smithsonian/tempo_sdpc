!
!> @ioaction@ a @dim@d array @iodir@ a @dim@d variable of type @ftype@ (kind=@fkind@) as type @ntype@
  subroutine tiof_@action@@dim@d_@type@ (obj, name, start, edge, array, errstat)
    implicit none
    type (tiof_file_type), intent(in) :: obj
    character (len=*), intent(in) :: name
    integer, dimension(:), intent(in) :: start, edge
    @ftype@ (kind=@fkind@), dimension (@colons@), intent(@intent@) :: array
    integer, intent(inout) :: errstat

    integer :: err

    if (errstat < 0) return

    err = tiof_@action@_var_section (obj % groupid, name, start, edge, &
                                     @ntype@, array)
    if (err < 0) then
      call tell_error (tell_io_@ioaction@_error, "Unable to @ioaction@ " // &
                       trim(name) // " @iodir@ file", errstat)
      return
    endif
  end subroutine tiof_@action@@dim@d_@type@
