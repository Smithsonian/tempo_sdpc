#include <stdint.h>

#define __USE_XOPEN
#include <time.h>

/* L1 File format version number */
#define TIO_L1_FORMAT_VERSION  2

#define TIO_FORMAT_CONVENTIONS   "CF-1.6, ACDD-1.3"

#define TEMPO_BAND_NAME_UV   "band_290_490_nm"
#define TEMPO_BAND_NAME_VIS  "band_540_740_nm"

/* Product type names */
@CSV_PROD@

/* File dimension names */
@CSV_DIMS@

/* File group names */
@CSV_GRPS@

/* File variable names */
@CSV_VARS@

#define TIO_FILL_RADIANCE  (-TIO_FILL_FLOAT)
#define TIO_FILL_IRRADIANCE  (-TIO_FILL_FLOAT)

#define TIO_FILL_RADIANCE_ERROR (-TIO_FILL_FLOAT)
#define TIO_FILL_IRRADIANCE_ERROR (-TIO_FILL_FLOAT)

#define TIO_INR_ERROR  "-1"
#define TIO_INR_NONE    "0"
#define TIO_INR_INITIAL "1"
#define TIO_INR_FINAL   "2"

typedef struct
{
   char *name;
   size_t num_xtrack;
   size_t num_channels;
}
TIO_Scan_Group_Type;

/** Create a template Level 1 radiance data file
 * @param  ncid          Index returned by nc_create
 * @param  product_type  Product type string
 * @param  num_steps     Number of mirror steps
 * @param  num_sgrps     Number of scan groups
 * @param  sgrps         Array of TIO_Scan_Group_Type structs
 * @return 0 on success, -1 on error
 */
extern int TIO_l1_radiance_template (int ncid, const char *product_type, size_t num_steps,
                                     int num_sgrps, TIO_Scan_Group_Type *sgrps);

/** Define solar and viewing angle variables for a Level 1 radiance file
 * @param[in]  grp     NetCDF file group index
 * @return 0 on success, -1 on error
 */
extern int tio_def_l1_radiance_angle_vars (int grp);

/** Define ground pixel quality flag variable for a Level 1 radiance file
 * @param[in]  grp     NetCDF file group index
 * @return 0 on success, -1 on error
 */
extern int tio_def_var_ground_pixel_quality_flag (int grp);

/** Define earth-sun distance
 * @param[in]  grp    NetCDF file group index
 * @param[in]  earth_sun_distance  Earth-sun distance [meters]
 * @return 0 on success, -1 on error
 */
extern int tio_set_earth_sun_distance (int grp, double earth_sun_distance);

/** Create a template Level 1 working irradiance data file
 * @param  ncid          Index returned by nc_create
 * @param  product_type  Product type string
 * @param  num_steps     Number of mirror steps
 * @param  num_sgrps     Number of scan groups
 * @param  sgrps         Array of TIO_Scan_Group_Type structs
 * @return 0 on success, -1 on error
 */
extern int TIO_l1_irradiance_template (int ncid, const char *product_type, size_t num_steps,
                                       int num_sgrps, TIO_Scan_Group_Type *sgrps);

/** Create a template Level 1 reference irradiance data file
 * @param  ncid          Index returned by nc_create
 * @param  num_steps     Number of mirror steps
 * @param  num_sgrps     Number of scan groups
 * @param  sgrps         Array of TIO_Scan_Group_Type structs
 * @return 0 on success, -1 on error
 */
extern int TIO_l1_ref_irradiance_template (int ncid, size_t num_steps, int num_sgrps,
                                           TIO_Scan_Group_Type *sgrps);

#define TEMPO_GRANULE_FLAG_IS_FIRST           0x1
#define TEMPO_GRANULE_FLAG_IS_LAST            0x2
#define TEMPO_GRANULE_FLAG_IS_TELEMETRY_ONLY  0x4
#define TEMPO_GRANULE_FLAG_SCAN_SEQ_START     0x8
extern int tio_define_granule_flag_var (int ncid);
extern int tio_write_granule_flag_var (int ncid, int granule_flag);
extern int tio_copy_granule_flag_var (int ncid_from, int ncid_to);

extern int tio_define_dim_step_var (int grp, int dimid);

#define TEMPO_SCAN_TYPE_NIGHTLIGHTS    0x1
#define TEMPO_SCAN_TYPE_SCAN_SEQ_START 0x2
extern int tio_make_scan_label (uint16_t *scan_label, uint16_t scan_type, uint16_t scan_num);
extern void tio_parse_scan_label (uint16_t scan_label, uint16_t *scan_type, uint16_t *scan_num);

extern int tio_write_granule_ident_indices (int ncid, int scan_num, int granule_num);
extern int tio_write_granule_ident_times (int ncid, double tstart,
                                          double tend);

/** Copy granule identification metadata from one netcdf file to another
 * @param  ncid_from     Index of source netcdf file
 * @param  ncid_to       Index of destination netcdf file
 * @return 0 on success, -1 on error
 */
extern int TIO_copy_granule_ident (int ncid_from, int ncid_to);

/** Compare granule identification metadata from one netcdf file to another
 * @param  ncid1       Index of first netcdf file
 * @param  ncid2       Index of second netcdf file
 * @return -1 on error,
 *          0 when granule identification metadata differ,
 *          1 when granule identification metadata are the same
 */
extern int TIO_same_granule_ident (int ncid1, int ncid2);

/** Generate a filename string using granule identification metadata
 *  in a netcdf file header.
 * @param  ncid          Index of source netcdf file
 * @param  label         Label string to include in the filename string
 * @param  level         Processing level number (e.g. 0, 1, 2, 3)
 * @param  version       Processing version number to include in the filename string
 * @param  buf           Buffer to hold the output filename string
 * @param  bufsize       Size of the output filename buffer
 * @return On error, a negative value is returned.  On success, the
 *         return value is the number of characters that would have been
 *         needed for the filename if space was available.  Thus,
 *         a return value of \c bufsize or more indicates that the
 *         output was truncated.
 *
 * Note that the label string can be either a valid label, or a format
 * definition such as "%s".  The latter is useful for creating a filename
 * template string.
 */
extern int TIO_filename_from_granule (int ncid, const char *label, int level, int version,
                                      char *buf, int bufsize);

/** Generate a scan granule filename string.
 * @param  buf           Buffer to hold filename string
 * @param  bufsize       Size of filename buffer
 * @param  tstart        TAI seconds elapsed since the TEMPO epoch
 * @param  label         Label string to include in the filename string (e.g. rad)
 * @param  level         Processing level number (e.g. 0, 1, 2, 3)
 * @param  version       Processing version number to include in the filename string
 * @param  scan_num      Scan number (>0)
 * @param  granule_num   Granule number (>0)
 * @return On error, a negative value is returned.  On success, the
 *         return value is the number of characters that would have been
 *         needed for the filename if space was available.  Thus,
 *         a return value of \c bufsize or more indicates that the
 *         output was truncated.
 *
 * Note that the label string can be either a valid label, or a format
 * definition such as "%s".  The latter is useful for creating a filename
 * template string.
 */
extern int __tio_filename_string_indexed (char *buf, int bufsize,
                                          double tstart, const char *label, int level, int version,
                                          int scan_num, int granule_num);

/** Generate a filename string.
 * @param  buf           Buffer to hold filename string
 * @param  bufsize       Size of filename buffer
 * @param  tstart        TAI seconds elapsed since the TEMPO epoch
 * @param  label         Label string to include in the filename string (e.g. IRR, DRK, IRU, SMC...)
 * @param  level         Processing level number (e.g. 0, 1, 2, 3)
 * @param  version       Processing version number to include in the filename string
 * @return On error, a negative value is returned.  On success, the
 *         return value is the number of characters that would have been
 *         needed for the filename if space was available.  Thus,
 *         a return value of \c bufsize or more indicates that the
 *         output was truncated.
 *
 * Note that the label string can be either a valid label, or a format
 * definition such as "%s".  The latter is useful for creating a filename
 * template string.
 */
extern int __tio_filename_string (char *buf, int bufsize,
                                  double tstart, const char *label, int level, int version);

/** Write product_type and processing version metadata to a netcdf header
 * @param  ncid              Index of destination netcdf file
 * @param  product_type      Product type string, e.g. "RAD"
 * @param  processing_level  Processing level number, e.g. 0,1,2,3
 * @param  version           Processing version number
 * @return 0 on success, -1 on error
 */
extern int TIO_label_product (int ncid, const char *product_type, int level, int version);

/** Allocate a new TIO_Scan_Ident_Type object
 * @return TIO_Scan_Ident_Type pointer on success,
 *         NULL on error
 *
 * To avoid memory leaks, the pointer must eventually be freed by
 * TIO_free_scan_ident
 */
extern TIO_Scan_Ident_Type *TIO_new_scan_ident (void);

/** Free an allocated TIO_Scan_Ident_Type object
 * @param  lst            TIO_Scan_Ident_Type object allocated by a call
 *                        to TIO_new_scan_ident
 */
extern void TIO_free_scan_ident (TIO_Scan_Ident_Type *lst);

/** Append granule identification metadata to a TIO_Scan_Ident_Type object
 * @param  ncid           Index of source netcdf file
 * @param  lst            TIO_Scan_Ident_Type object allocated by a call
 *                        to TIO_new_scan_ident
 * @return 0 on success, -1 on error
 */
extern int TIO_attach_granule_ident (int ncid, TIO_Scan_Ident_Type *lst);

/** Write scan identification metadata to a netcdf file
 * @param  ncid           Index of destination netcdf file
 * @param  lst            TIO_Scan_Ident_Type object allocated by a call
 *                        to TIO_new_scan_ident
 * @return 0 on success, -1 on error
 */
extern int TIO_write_scan_ident (int ncid, TIO_Scan_Ident_Type *lst);

extern int tio_scan_start_time (TIO_Scan_Ident_Type *lst, double *tstart);

/** Create UTC timestamp string based on the TEMPO epoch
 * @param sec_since_epoch    TAI number of elapsed seconds since the epoch.
 * @param delim              If 0, format time as HHMMSS, otherwise, as HH:MM:SS
 * @param buf                Pointer to the buffer to receive the string
 * @param bufsize            Size of character buffer
 * @return 0 on success, -1 on error
 */
extern int TIO_mktimestamp_str (double sec_since_epoch, int delim, char *buf,
                                int bufsize);

/** Write timestamp attributes
 * @param ncid             Index of destination netcdf file
 * @param varid            Variable id to receive attributes (usually NC_GLOBAL)
 * @param attr_base_name   Attribute base name
 * @param secs_since_epoch Timestamp value [TAI seconds since epoch]
 * @return 0 on success, -1 on error
 *
 * Two timestamp attributes are written.  The first is an ISO 8601
 * formatted string giving the UTC time, the second is a double precision
 * floating point value containing the number of TAI seconds since the epoch.
 * The epoch definition is taken from the file's \c time_reference
 * global attribute.
 */
extern int TIO_write_timestamp (int ncid, int varid,
                                const char *attr_base_name,
                                double secs_since_epoch);

/** Write time_reference attribute string containing the TEMPO epoch
 * @param ncid    Index of destination netcdf file
 * @param varid   Variable id to receive attribute (usually NC_GLOBAL)
 * @return 0 on success, -1 on error
 * Use \a tio_time_set_tempo_epoch to set the epoch.
*/
extern int tio_write_epoch_timestamp (int ncid, int varid);

/** Write a timestamp units string that contains the the TEMPO epoch
 * @param ncid    Index of destination netcdf file
 * @param varname Variable name to receive attribute
 * @return 0 on success, -1 on error
 * Use \a tio_time_set_tempo_epoch to set the epoch.
*/
extern int tio_write_timestamp_unit_string (int ncid, const char *varname);

#if 0
{
#endif
#ifdef __cplusplus
}
#endif

#endif
