# -*- sh -*-

prefix     = @prefix@
config_dir = @CONFIG_DIR@

COMPILER_SUITE = @COMPILER_SUITE@
OTS_ROOT       = @OTS_ROOT@

archobjs = $(COMPILER_SUITE)objs

SHELL=/bin/sh

ifeq ($(COMPILER_SUITE), gnu)
  LDFLAGS      = $(LFLAGS) @LDFLAGS_COV@ -Wl,-export-dynamic

  CC           = gcc
  CCFLAGS      = $(CFLAGS) @CFLAGS_COV@ -DLINUX -Df2cFortran -Wno-missing-prototypes -Wno-c++-compat
  DL_LIB       = -ldl
  ELF_CC       = $(CC)
  ELF_CFLAGS   = $(CCFLAGS) -fPIC
  ELF_LINK     = $(CC) $(CFLAGS) $(LDFLAGS) -shared -Wl,-O1 -Wl,-soname,$(ELFLIB_MAJOR)
  ELF_DEP_LIBS = $(DL_LIB) -lm -lc
#
  FC           = gfortran
  FCFLAGS      = $(FFLAGS) @FCFLAGS_COV@ -fPIC -Wno-compare-reals
  ELF_FC       = $(FC)
  ELF_F_LINK   = $(CC) $(FFLAGS) $(LDFLAGS) -shared -Wl,-O1 -Wl,-soname,$(ELFLIB_F_MAJOR)
  MODFLG       = -I
  MODOUTFLG    = -J
  RPATH        = -Wl,-rpath=$(OTS_ROOT)/lib
  FC_EXTRA_LIBS =#

# target specific variables propagated to every makefile that includes this one
  all-opt :: export CFLAGS=-O3 -Wall -W -Wextra
  all-opt :: export FFLAGS=-O3 -Wall -W -Wextra
  all-opt :: export LFLAGS=#

# more FFLAGS: -ffpe-trap=invalid,zero,overflow -finit-real=snan
  all-dbg :: export CFLAGS=-g -ggdb -Wall -W -Wextra -Wformat=2 -Wunused -Wundef -Wno-long-long -Winline -Wmissing-prototypes -Wnested-externs -Wpointer-arith -Wcast-align -Wshadow -Wstrict-prototypes -Wc++-compat -fdiagnostics-color=never
  all-dbg :: export FFLAGS=-g -ggdb -Wall -W -Wextra -Warray-bounds -Wno-unused-dummy-argument -fcheck=all -fbounds-check -fmax-errors=0 -fbacktrace -fcheck-array-temporaries -fdiagnostics-color=never
  all-dbg :: export LFLAGS=#

  all-gprof :: export CFLAGS += -pg -no-pie -fprofile-arcs -ftest-coverage -lgcov
  all-gprof :: export FFLAGS += -pg -no-pie -fprofile-arcs -ftest-coverage -lgcov
  all-gprof :: export LFLAGS += -pg -fprofile-arcs -lgcov
endif

ifeq ($(COMPILER_SUITE), intel)
  INTEL_ROOT   = /opt/intel
  LDFLAGS      = $(LFLAGS)

  CC           = $(INTEL_ROOT)/bin/icc
  CCFLAGS      = $(CFLAGS) -fpic -DLINUX -Df2cFortran
  DL_LIB       = -ldl
  ELF_CC       = $(CC)
  ELF_CFLAGS   = $(CCFLAGS)
  ELF_LINK     = $(CC) $(LDFLAGS) -shared
  ELF_DEP_LIBS = $(DL_LIB) -lm -lc
#
  FC           = $(INTEL_ROOT)/bin/ifort
  FCFLAGS      = $(FFLAGS) -fpic
  ELF_FC       = $(FC)
  ELF_F_LINK   = $(FC) $(LDFLAGS) -shared
  MODFLG       = -I
  MODOUTFLG    = -module
  LONG_BIT      = $(shell getconf LONG_BIT)
  FC_EXTRA_LIBS = $(INTEL_ROOT)/lib/intel$(LONG_BIT)
  RPATH        = -Wl,-rpath=$(FC_EXTRA_LIBS):$(HDFEOS5_LIB):$(HDFEOS_LIB):$(PGSLIB):$(HDF5LIB):$(HDFLIB)

# target specific variables propagated to every makefile that includes this one
  all-opt :: export CFLAGS=-O3
  all-opt :: export FFLAGS=-O3
  all-opt :: export LFLAGS=#

  all-dbg :: export CFLAGS=-O0 -g -debug all -traceback -check-uninit
  all-dbg :: export FFLAGS=-O0 -g -debug all -traceback -check bounds -check arg_temp_created -fpe0 -ftrapuv
  all-dbg :: export LFLAGS=#
endif

INSTALL = @INSTALL@
INSTALL_DATA = @INSTALL_DATA@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
MKINSDIR = $(config_dir)/autoconf/mkinsdir.sh

DEPMOD = $(config_dir)/utils/f90depmod.sl

RM = /bin/rm
LN = /bin/ln -sf
CP = /bin/cp

TELL_LIB    = @TELL_LIB@
TELL_INC    = @TELL_INC@

SDPTK_VERSION = @SDPTK_VERSION@
OMIUTIL       = $(OTS_ROOT)/sdptk/SDPTK$(SDPTK_VERSION)

HDFLIB      = @HDFLIB@
HDFINC      = @HDFINC@
HDF5LIB     = @HDF5LIB@
HDF5INC     = @HDF5INC@
PGSBIN      = @PGSBIN@
PGSLIB      = @PGSLIB@
PGSINC      = @PGSINC@
HDFEOS_LIB  = @HDFEOS_LIB@
HDFEOS_INC  = @HDFEOS_INC@
HDFEOS5_LIB = @HDFEOS5_LIB@
HDFEOS5_INC = @HDFEOS5_INC@

NETCDF_LIB  = @NETCDF_LIB@
NETCDF_INC  = @NETCDF_INC@

PROJ_LIB    = @PROJ_LIB@
PROJ_INC    = @PROJ_INC@

SLNOVAS_LIB = @SLNOVAS_LIB@
SLNOVAS_INC = @SLNOVAS_INC@

GEOTIFF_LIB = @GEOTIFF_LIB@
GEOTIFF_INC = @GEOTIFF_INC@

TIFF_LIB = @TIFF_LIB@
TIFF_INC = @TIFF_INC@

LIBCONFIG_LIB = @LIBCONFIG_LIB@
LIBCONFIG_INC = @LIBCONFIG_INC@

INR_LIB = @INR_LIB@
INR_INC = @INR_INC@

INROTS_LIB = @INROTS_LIB@
INROTS_INC = @INROTS_INC@
INROTS_EXTRA_LIBS = @INROTS_EXTRA_LIBS@

ECCODES_LIB = @ECCODES_LIB@
ECCODES_INC = @ECCODES_INC@

GSL_LIBPATHS = -lgsl @GSL_BLAS@

LEAP_SECONDS_LIST = @LEAP_SECONDS_LIST@

SQLITE3_LIB  = @SQLITE3_LIB@ -lsqlite3
SQLITE3_INC  = @SQLITE3_INC@

# Target-specific compiler options have been defined above.
# Doing a 'make all-opt' will build using the all-opt compiler flags defined above.
# These build targets are propagated to all makefiles that include this one.
# For example, in any subdirectory, you can do 'make clean all-dbg' to compile
# with debug flags turned on, independent of how the environment has defined
# CFLAGS, FFLAGS, and LFLAGS.
all-dbg:
	$(MAKE) all

all-opt:
	$(MAKE) all

all-gprof:
	$(MAKE) all
