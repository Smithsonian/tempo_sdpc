
include ./Makefile.defines

@SET_MAKE@

RM = /bin/rm

TARGETS := all check docs clean distclean

BASE_LIBS   = libtio
OTHER_LIBS  = libmet libmd libclim

LIBRARIES   = $(BASE_LIBS) $(OTHER_LIBS)

PROGRAMS    = L1_trace_gas L1_cloud L1_o3_total L1_o3_profile L2_regrid L2_split \
              L0_format L0_ccd wavecal L1_inr_prep L1_inr_post plan pipe utils

$(OTHER_LIBS):	$(BASE_LIBS)
$(PROGRAMS):	$(LIBRARIES)

SUBDIRS :=  $(LIBRARIES) $(PROGRAMS)

.PHONY:	$(TARGETS) install install-version $(SUBDIRS)

$(TARGETS):	 $(SUBDIRS)
install:	 $(SUBDIRS) install-version

install-version:
	./utils/get_sdpc_version.sh > sdpc_version && \
	$(INSTALL_DATA) sdpc_version $(prefix)/etc

$(SUBDIRS):
	$(MAKE) -C $@ $(MAKECMDGOALS)

confclean:
	-$(RM) Makefile Makefile.defines config.status config.log
