
@SET_MAKE@

RM = /bin/rm

DIR_LIST = libtio libmet libmd L1_trace_gas L1_cloud L1_o3_total L1_o3_profile \
           L2_regrid L0_format L0_ccd L1_inr_prep L1_inr_post L2_split \
           plan pipe

all:
	for dir in $(DIR_LIST) ; do \
	  (cd $$dir ; $(MAKE) all) || exit; \
	done

check:
	for dir in $(DIR_LIST) ; do \
	  (cd $$dir ; $(MAKE) check) || exit; \
	done

docs:
	for dir in $(DIR_LIST) ; do \
	  (cd $$dir ; $(MAKE) docs) || exit; \
	done

install:
	for dir in $(DIR_LIST) ; do \
	  (cd $$dir ; $(MAKE) install) || exit; \
	done

clean:
	for dir in $(DIR_LIST) ; do \
	  (cd $$dir ; $(MAKE) clean) || exit; \
	done

distclean:	clean
	for dir in $(DIR_LIST) ; do \
	  (cd $$dir ; $(MAKE) distclean) || exit; \
	done
	$(MAKE) confclean

confclean:
	-$(RM) Makefile Makefile.defines config.status config.log
