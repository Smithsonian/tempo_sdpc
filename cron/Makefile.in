# -*- sh -*-

SDPC_ANCILLARY_ROOT = @ANCILLARY_DATA_DIR@

all:
	@echo "targets: install"

SCRIPT_FILES = crontab.sh register_iers.py \
               pull_ims.sh pull_goes.sh pull_geoscf.sh pull_iers.sh \
               asdc_push_files.sh asdc_pull_ack.sh

ETC_FILES = crontab crontab.conf logrotate.conf alert_message.tmpl

SCRIPT_FILES_INSTALL_DIR = $(SDPC_ANCILLARY_ROOT)/bin
ETC_FILES_INSTALL_DIR = $(SDPC_ANCILLARY_ROOT)/etc

INSTALL = @INSTALL@
INSTALL_DATA = ${INSTALL} -m 664
MKINSDIR = ../autoconf/mkinsdir.sh

install_dirs:
	$(MKINSDIR) $(ETC_FILES_INSTALL_DIR)
	$(MKINSDIR) $(SCRIPT_FILES_INSTALL_DIR)

install_etc:
	@for X in $(ETC_FILES); \
	do \
		echo $(INSTALL_DATA) $$X $(ETC_FILES_INSTALL_DIR); \
		$(INSTALL_DATA) $$X $(ETC_FILES_INSTALL_DIR); \
		if [ "$$?" != "0" ]; then \
		  exit 1; \
		fi; \
	done

install_scripts:
	@for X in $(SCRIPT_FILES); \
	do \
		echo $(INSTALL) $$X $(SCRIPT_FILES_INSTALL_DIR); \
		$(INSTALL) $$X $(SCRIPT_FILES_INSTALL_DIR); \
		if [ "$$?" != "0" ]; then \
		  exit 1; \
		fi; \
	done

install:	install_dirs install_scripts install_etc

