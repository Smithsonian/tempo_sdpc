# see "man logrotate" for details
# rotate log files weekly
weekly

# keep 4 weeks worth of backlogs
rotate 4

# create new (empty) log files after rotating old ones
create

# use date as a suffix of the rotated file
#dateext

# uncomment this if you want your log files compressed
compress

@ANCILLARY_DATA_DIR@/var/log/geoscf.log
@ANCILLARY_DATA_DIR@/var/log/goes.log
@ANCILLARY_DATA_DIR@/var/log/ims.log
@ANCILLARY_DATA_DIR@/var/log/asdc_geoscf.log
@ANCILLARY_DATA_DIR@/var/log/cleanup.log
@ANCILLARY_DATA_DIR@/var/log/asdc_goes.log
{
        missingok
        notifempty
        delaycompress
}
