#
MAILTO=jhouck@cfa.harvard.edu
SDPC_ANCILLARY_ROOT=@ANCILLARY_DATA_DIR@
SDPC_ROOT=@prefix@
SDPC_OTS_ROOT=@OTS_ROOT@
#
# fields: min,hr,day_of_month,month,day_of_week

@reboot	echo "temposdpc00 rebooted" | mailx -s reboot jhouck@cfa.harvard.edu

# IMS snow cover: daily
15	11	* * * cd $SDPC_ANCILLARY_ROOT && mkdir -p var/log && bin/crontab.sh IMS >> var/log/ims.log 2>&1

# IERS bulletin A: Updates released weekly, on Thursdays, usually by 20:00Z.
#                  Download week-old bulletin to reduce possibility of trouble from new release.
15	0	* * wed cd $SDPC_ANCILLARY_ROOT && mkdir -p var/log && bin/crontab.sh IERS >> var/log/iers.log 2>&1

# GOES data: Mode 6 updates every 10 min
5-59/10 *	* * * cd $SDPC_ANCILLARY_ROOT && mkdir -p var/log && bin/crontab.sh GOES >> var/log/goes.log 2>&1

# GEOS-CF data: daily
7	4	* * * cd $SDPC_ANCILLARY_ROOT && mkdir -p var/log && bin/crontab.sh GEOSCF >> var/log/geoscf.log 2>&1

# Ancillary data to ASDC:
7	3,21	* * * cd $SDPC_ANCILLARY_ROOT && mkdir -p var/log && bin/crontab.sh ASDC_GOES >> var/log/asdc_goes.log 2>&1
7	1,23	* * * cd $SDPC_ANCILLARY_ROOT && mkdir -p var/log && bin/crontab.sh ASDC_GEOSCF >> var/log/asdc_geoscf.log 2>&1
7	2	* * * cd $SDPC_ANCILLARY_ROOT && mkdir -p var/log && bin/crontab.sh ASDC_IMS >> var/log/asdc_ims.log 2>&1

# cleanup
@weekly		cd $SDPC_ANCILLARY_ROOT && mkdir -p var/log && /usr/sbin/logrotate -s var/log/logstate etc/logrotate.conf
@daily		cd $SDPC_ANCILLARY_ROOT && mkdir -p var/log && bin/crontab.sh CLEANUP >> var/log/cleanup.log 2>&1
