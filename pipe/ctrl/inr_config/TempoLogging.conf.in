##
## @file TempoLogging.conf
##
## Official logging configuration for the TEMPO Pipeline.
##
## @author Kerrie Allen : kallen@carrastro.com
## @version kallen: 20 Oct 2014: Initial coding.
##

--default
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/master-%datetime{%Y%M%d}.log"
   ENABLED              =  true
   TO_FILE              =  true
   TO_STANDARD_OUTPUT   =  true
   MILLISECONDS_WIDTH   =  6
   PERFORMANCE_TRACKING =  true

* TRACE:
   ENABLED              =  true
*INFO:
   ENABLED              =  true
* DEBUG:
    ENABLED             =  true
* WARNING:
    ENABLED             =  true
*ERROR:
    ENABLED             =  true
*FATAL:
   ENABLED              =  true

--store
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/store-%datetime{%Y%M%d}.log"
   ENABLED              =  true
   TO_FILE              =  true
   TO_STANDARD_OUTPUT   =  false
* TRACE:
   ENABLED              =  true
* INFO:
   ENABLED              =  true
* DEBUG:
   ENABLED              =  true

--pipeline
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/pipeline-%datetime{%d%b%Y}.log"
   ENABLED              =  true
   TO_FILE              =  true
   TO_STANDARD_OUTPUT   =  false
* TRACE:
   ENABLED              =  true
* INFO:
   ENABLED              =  true
* DEBUG:
   ENABLED              =  true

--processing
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/processing-%datetime{%Y%M%d}.log"
   ENABLED              =  true
   TO_FILE              =  true
   TO_STANDARD_OUTPUT   =  false
* TRACE:
   ENABLED              =  true
* INFO:
   ENABLED              =  true
* DEBUG:
   ENABLED              =  true

--filter
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/filter-%datetime{%Y%M%d}.log"
   ENABLED              =  true
   TO_FILE              =  true
   TO_STANDARD_OUTPUT   =  false
* TRACE:
   ENABLED              =  true
* INFO:
   ENABLED              =  true
* DEBUG:
   ENABLED              =  true

--external
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/external-%datetime{%Y%M%d}.log"
   ENABLED              =  false
   TO_FILE              =  false
   TO_STANDARD_OUTPUT   =  false
* TRACE:
   ENABLED              =  true
* INFO:
   ENABLED              =  true
* DEBUG:
   ENABLED              =  true
