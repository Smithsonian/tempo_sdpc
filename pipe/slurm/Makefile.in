# -*- sh -*-

prefix = @prefix@
SCRIPT_FILES_INSTALL_DIR = $(prefix)/bin

all:
	@echo "targets: install"

SCRIPT_FILES= level1a.sh level1a_batch.sh \
              level1b.sh level1b_batch.sh \
              level2.sh level2_batch.sh level2_finish.sh \
              wavecal.sh \
              o3tot.sh tracegas.sh \
              o3prof_batch.sh o3prof_block.sh o3prof_merge.sh o3prof_util.sh \
              level3.sh \
              level1b_nrt1.sh level1b_nrt1_batch.sh \
              level1b_nrt2.sh level1b_nrt2_batch.sh

INSTALL = @INSTALL@
MKINSDIR = ../../autoconf/mkinsdir.sh

install_directories:
	$(MKINSDIR) $(SCRIPT_FILES_INSTALL_DIR)

install_scripts:
	@for X in $(SCRIPT_FILES); \
	do \
		echo $(INSTALL) $$X $(SCRIPT_FILES_INSTALL_DIR); \
		$(INSTALL) $$X $(SCRIPT_FILES_INSTALL_DIR); \
		if [ "$$?" != "0" ]; then \
		  exit 1; \
		fi; \
	done

install:	install_directories install_scripts
