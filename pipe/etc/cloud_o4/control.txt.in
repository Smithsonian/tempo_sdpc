Input Files:
  TEMPOL1RAD_dir:
    - ../
  TEMPOL1RAD_fnm:
    - @radiance_file@
  TEMPOO4SCD_dir:
    - ./
  TEMPOO4SCD_fnm:
    - @cldo4_file@
  TEMPOL1IRR_dir:
    - ../
  TEMPOL1IRR_fnm:
    - @irradiance_file@
  TEMPOdiaglog_dir:
    - ./
  TEMPOdiaglog_fnm:
    - diaglog_O2O2.nc
  OMGLER:
    - Not_used_for_TEMPO
  Kleipool_dir:
    - @refdata_dir@
  desfac_dir:
    - ./
  desfac_fnm:
    - replace_with_desfac_file
  Kleipool_fnm:
    - OMI-Aura_L3-OMLER_2005m01-2009m12_v003-2010m0503t063707.he5
  GMI_dir:
    - @refdata_dir@
  LUT_dir:
    - @refdata_dir@
  LUT_RAD_440:
    - LUT_4400_RAD.h5
  LUT_RAD_466:
    - LUT_4660_RAD.h5
  477000:
    - LUT_4770_CLEAR.h5
  477001:
    - LUT_4770_CLOUD_MLER.h5
  477010:
    - LUT_4770_CLOUD_LER_6D.h5

Output Files:
   TEMPOCLDO4:
    - @product_file@

Name Options:
  T-P profile:
   - GEOS5
  Surface Reflectivity:
   - BRDF

Runtime Parameters:
    RunMode: production
    APPShortName: TEMPOCLDO4
    APPVersion: 1.0.0.0
    AuthorName: H. Wang, G. Gonzalez Abad, E. O'Sullivan, J. Houck, C. Nowlan, E.Yang, A. Vasilkov, X. Liu, K. Chance
    AuthorAffiliation: TEMPO Science Team
    ProcessingCenter: SAO
    TEMPO Footprint: UV
    Collection: 002
    ixdebug: -1
    itdebug: -1
    option_destripe_scd: @apply_destripe@
    ecfocp_maxiter: 5
    option_scdfullfilter: 1
    option_apply_solshift: @apply_solshift@
    option_apply_radshift: @apply_radshift@

Perturbations:
    Perturb_Alb466: N
    Perturb_RadOfIrr466: N
    Perturb_O4SCD: N
    Perturb_ECF: N
