twae 0 0 0     ; Tropospheric single scattering albedo (at last wavelength)
saod 0 0 0     ; Stratospheric aerosol optical thickness (w=1.0)
sprs 0 0 0     ; offset to input/derived surface pressure
so2z 0 0 0     1.0 0.0 30.0

