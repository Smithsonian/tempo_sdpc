# TEMPO destriping and background correction control file.
# This is a YAML file. It has to be run for each species after a full
# scan of slant column densities and air mass factor calculations is 
# completed. If using any of this corrections for NO2, the stratospheric
# tropospheric separation should be run after applying the de-striping
# and/or radiance reference sector correction

# The control file provides controls to choose which correctios to apply to
# input level 2 files
# It always output the corrections to an auxiliary file to
# Radiance input files
Input files:
@LEVEL2_PRODUCT_PATHS@
# Use only pixels with mincfr < cloud fraction < maxcfr
mincfr: 0.0
maxcfr: 0.5
# RMS number of standard deviations (STD) to filter out pixels considered in the
# destriping and background corrections. MEDIAN(RMS) + nsigma*msig
# with msig = 1.4826 x MEDIAN(|RMS - MEDIAN(RMS)|)
nsigma: 1.0
# Main data quality flags of pixels to be considered in the corrections
mqfval: [0]
# Percentile used to calculate background correction
# Only use pixels below "percentile" (a number between
# 0 and 100)
percentile: 90
# Kernel size of median filter
kernel: 250
# Correction file attributes
processing_version: 1
output_filename: @DESTRIPE_FILE_PATH@
title: TEMPO destriping and background corrections for HCHO
# Switch to save diagnostic info to files
yn_diagnostic: F
