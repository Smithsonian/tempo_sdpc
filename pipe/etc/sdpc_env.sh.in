#---------------------------
#  Installed software paths:
#---------------------------

# SDPC_ROOT = root directory where pipeline processing software is installed
export SDPC_ROOT="@prefix@"

# SDPC_INRSW_ROOT = root directory where INR SW is installed
export SDPC_INRSW_ROOT="@INRSW_ROOT@"

# SDPC_OTS_ROOT = root directory where OTS software is installed
export SDPC_OTS_ROOT="@OTS_ROOT@"

# SDPC_S6_ROOT = root directory where s6 supervisor is installed
export SDPC_S6_ROOT="@S6_ROOT_DIR@"

#---------------------------------
#  Installed reference data paths:
#---------------------------------

# ANCILLARY_DIR contains time-sensitive reference data,
# shared by all processing nodes
# (e.g. GOES data, meteorology data, snow & ice cover)
export SDPC_ANCILLARY_ROOT="@ANCILLARY_DATA_DIR@"

# SDPC_ANCILLARY_IMS_DBFILE = path to IMS sqlite file
# (technically, this should be on a local disk, and not be NFS mounted)
export SDPC_ANCILLARY_IMS_DBFILE="${SDPC_ANCILLARY_ROOT}/var/ims/ims.sqlite"

# SDPC_REFDATA_DIR contains static reference data,
# shared by all processing nodes
# (e.g. reference spectra, cross-sections, climatologies, etc.)
export SDPC_REFDATA_DIR="@REFDATA_DIR@"

#-----------------------------------------
#  Environment-dependent pipeline defaults
#-----------------------------------------

# SDPC_PIPE_HOME = default location for primary node run directories
: "${SDPC_PIPE_HOME:=@PIPE_HOME@}"
export SDPC_PIPE_HOME

: "${SDPC_PIPE_NAME:=sdpc_test}"
export SDPC_PIPE_NAME

: "${SDPC_PROCESSING_VERSION:=1}"
export SDPC_PROCESSING_VERSION

# SDPC_ARCHIVE_HOME = default location for pipeline-specific archive directories
: "${SDPC_ARCHIVE_HOME:=@ARCHIVE_HOME@}"
export SDPC_ARCHIVE_HOME

# SDPC_ARCHIVE_DIR = root directory for the pipeline-specific archive
export SDPC_ARCHIVE_DIR="${SDPC_ARCHIVE_HOME}/${USER}/${SDPC_PIPE_NAME}"

# SDPC_ARCHIVE_DBFILE = absolute path to sqlite file on a local disk (NOT NFS MOUNTED!!)
export SDPC_ARCHIVE_DBFILE="/scratch/${USER}/${SDPC_PIPE_NAME}/archived_products.sqlite"

# Level 0 IRU, SMC, HK file lookup can use a separate database
export SDPC_ARCHIVE_DBFILE_L0="${SDPC_ARCHIVE_DBFILE}"

# Level 1 IRR file lookup can use a separate database
export SDPC_ARCHIVE_DBFILE_L1="${SDPC_ARCHIVE_DBFILE}"

#---------------------------------
#  Live processing directory paths
#---------------------------------

# SDPC_RUN_DIR_MASTER = root directory where pipeline processing takes place on the master node
export SDPC_RUN_DIR_MASTER="${SDPC_PIPE_HOME}/${SDPC_PIPE_NAME}"

# SDPC_RUN_DIR_INR = root directory where INR processing takes place on the master node
export SDPC_RUN_DIR_INR="${SDPC_RUN_DIR_MASTER}/inr"

# SDPC_RUN_DIR = root directory where pipeline processing takes place on compute nodes
export SDPC_RUN_DIR="/scratch/${USER}/${SDPC_PIPE_NAME}"

#---------------------------
#  Command search path, etc.
#---------------------------

_sdpc_paths="$SDPC_S6_ROOT/bin $SDPC_OTS_ROOT/bin $SDPC_ROOT/bin"

# Prepend SDPC path entries only if they are not already present
for x in $_sdpc_paths ; do
  case ":$PATH:" in
    *":$x:"*)
       # already in the path, do nothing
    ;;
    *)
       PATH="$x:$PATH"
    ;;
  esac
done
export PATH
