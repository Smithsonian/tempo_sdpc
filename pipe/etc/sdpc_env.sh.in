#---------------------------
#  Installed software paths:
#---------------------------

# SDPC_ROOT = root directory where pipeline processing software is installed
export SDPC_ROOT="@prefix@"

# SDPC_INRSW_ROOT = root directory where INR SW is installed
export SDPC_INRSW_ROOT="@INRSW_ROOT@"

# SDPC_OTS_ROOT = root directory where OTS software is installed
export SDPC_OTS_ROOT="@OTS_ROOT@"

# SDPC_S6_ROOT = root directory where s6 supervisor is installed
export SDPC_S6_ROOT="@S6_ROOT_DIR@"

#---------------------------------
#  Installed reference data paths:
#---------------------------------

# ANCILLARY_DIR contains time-sensitive reference data,
# shared by all processing nodes
# (e.g. GOES data, meteorology data, snow & ice cover)
export SDPC_ANCILLARY_ROOT="@ANCILLARY_DATA_DIR@"

# SDPC_REFDATA_DIR contains static reference data,
# shared by all processing nodes
# (e.g. reference spectra, cross-sections, climatologies, etc.)
export SDPC_REFDATA_DIR="@REFDATA_DIR@"

#------------------------------------------
#  Environment-dependent pipeline defaults:
#------------------------------------------

: "${SDPC_PIPE_NAME:=default}"
export SDPC_PIPE_NAME

#----------------
#  Archive paths:
#----------------

# archive_home = default location for pipeline-specific archive directories
archive_home="@ARCHIVE_HOME@"

# SDPC_ARCHIVE_DIR = root directory for the pipeline-specific archive
export SDPC_ARCHIVE_DIR="${archive_home}/${USER}/${SDPC_PIPE_NAME}"

# SDPC_ARCHIVE_DBFILE = absolute path to sqlite file on a local disk (NOT NFS MOUNTED!!)
export SDPC_ARCHIVE_DBFILE="/scratch/${USER}/${SDPC_PIPE_NAME}/archived_products.sqlite"

#-----------------
#  Pipeline paths:
#-----------------

# pipe_home = default location for primary node run directories
pipe_home="@PIPE_HOME@"

# SDPC_PIPE_DIR = root directory where pipeline processing takes place on the master node
export SDPC_PIPE_DIR="${pipe_home}/${USER}/${SDPC_PIPE_NAME}"

# SDPC_NODE_DIR = root directory where pipeline processing takes place on compute nodes
export SDPC_NODE_DIR="/scratch/${USER}/${SDPC_PIPE_NAME}"

#---------------------------
#  Command search path, etc.
#---------------------------

_sdpc_paths="$SDPC_S6_ROOT/bin $SDPC_OTS_ROOT/bin $SDPC_ROOT/bin"

# Prepend SDPC path entries only if they are not already present
for x in $_sdpc_paths ; do
  case ":$PATH:" in
    *":$x:"*)
       # already in the path, do nothing
    ;;
    *)
       PATH="$x:$PATH"
    ;;
  esac
done
export PATH
