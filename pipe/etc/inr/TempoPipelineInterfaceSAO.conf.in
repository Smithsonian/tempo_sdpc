### TEMPO INRSW Configuration Input File
###
### File is self documenting - comment lines are prefixed with hash, grouped parameters fall after brackets.
###

## Granule configuration

[Granules]

# Directory scanning method ("inotify" or "polling")
method=polling
# The threshold used by the Granule Monitor if "polling" is selected as the
# directory scanning method. A file is identified as a new file only
# if the difference between the current time and file last updated time is
# greater than the threshold. This is used to prevent the file being copied
# identified as a new file. Values are in milliseconds.
pollingThreshold=5000
# The polling interval used by the Granule Monitor if "polling" is selected as the
# directory scanning method. Values are in milliseconds
pollingSleepDuration=10000
# The method for loading the granule. Operationally it is "Real"
# "Mock" is used in some unit tests
loadMethod=Real
# Granule staging directory
imgDir=@INR_PROCESSING_ROOT@/Staging/Granules/
# Granule output directory
outDir=@INR_PROCESSING_ROOT@/Output/
# Granule output directory for GUI. Hard link of granules are created in this directory if this directory is provided.
guiOutDir=@INR_PROCESSING_ROOT@/Output/monitor_cache
# Nominal TEMPO longitude in degrees
refLon=-91.0
# The amount of time the server will wait for new granules before producing a warning, in seconds.
timeoutPeriod=900
# The maximum difference in time for two adjacent granules to be considered continuous, in milliseconds.
continuityInterval=5000
# The time of day to generate the status report, in seconds from 0:00 UTC.
statusReportTime=0
# The nominal amount of time each granule covers, in seconds
granuleTime=360
# The regular expression for filename to determine whether a file is a granule
filenameRegex=^TEMPO_RAD_L1_V(\d{2})_(\d{8})T(\d{6})Z_S(\d{3})G(\d{2})(\.\w+)??\.nc$
# The regular expression for GOES reference imagery
referenceRegex=^OR_ABI-(L\w{1,2})-(\w{4,})-(M\d)(C\d{2})_(G\d{2})_s(\d{4})(\d{3})(\d{2})(\d{2})(\d{2,3})_e(\d{4})(\d{3})(\d{2})(\d{2})(\d{2,3})_c(\d{4})(\d{3})(\d{2})(\d{2})(\d{2,3})\.nc$

## The actual time bounds of GNA cutout relatively to start time of Full Disk

[GNATimeBounds]

west_mode3_start=32
west_mode3_end=218
west_mode4_start=11
west_mode4_end=91
west_mode6_start=16
west_mode6_end=174
east_mode3_start=28
east_mode3_end=214
east_mode4_start=7
east_mode4_end=87
east_mode6_start=12
east_mode6_end=170

## Left reference image configuration

[Left]

# Source satellite type ("GOES-NOP" or "GOES-R")
type=GOES-R
# Source satellite ID ("13", "14" or "15" for type=="GOES-NOP", "16", "17", "18" for type == "GOES-R")
satID=18
# Reference longitude in degrees (-75.0 for GOES-13 East, -89.5 for GOES-14 Center, -135.0 for GOES-15 West)
# Note that this variable is completely ignored if type (above) is "GOES-R", since GOES-R data files include
# the subpoint of the satellite at the time of image creation
