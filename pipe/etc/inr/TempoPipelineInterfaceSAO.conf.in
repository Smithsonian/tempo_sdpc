## Parameters to control tie-point matching

[TiePoints]

# Size of template in up-sampled pixels
chipSize=72
# Size of search area for match in up-sampled pixels
hoodSize=144
# Step size for tie point sites vertically/horizontally in up-sampled pixels
chipStep=128
# Margin to leave at boundaries in up-sampled pixels
hoodMargin=128
# Limit on Earth central angle beyond which there are no tie points allowed in degrees
ECALimit=80
# Mode of measuring TiePoints. Possible values are "LEFT_REF", "RIGHT_REF", "BINOCULAR"
# "LEFT_REF" and "RIGHT_REF" is used when we are testing the software in AutoCorrelation Mode
mode=BINOCULAR
# Number of threads to be used for parallel processing
numThreads=4
# Flag indicating whether optical flow in reference images are used to improve calculations
# TRUE or FALSE
useOpticalFlow=FALSE
# The maximum number of loops to be used in optical flow
useOpticalFlowMaxLoops=10
# The position tolerance for optical flow calculation in km
useOpticalFlowRTol=1e-4
# The velocity tolerance for optical flow calculation in km/s
useOpticalFlowVTol=1e-5
# The cos of limb limit (cos(85*pi/180)) for binocular tie-point solution
cosLimb=0.087155742747658

## Parameters to control tie-point validity checking

[TiePointChecker]

# Minimum acceptable peak correlation
rhothreshold=0.8
# Maximum allowed solar zenith angle in degrees
solarZenithThreshold=80
# The minimum ellipse ratio
minEllipseRatio=0.1
# The maximum TiePoint horizontal shift in km
maxTPHorizontalShift=30
# The minimum parallax in km
minTPVerticalShift=-1
# The maximum parallax in km
maxTPVerticalShift=12
# The maximimum tiepoint horizontal residual
maxTPHorizontalResidual=50
# The maximimum tiepoint vertical residual
maxTPVerticalResidual=20

## Parameters related to the flight hardware

[satellite]

# Tilt of telescope with respect to mirror at home in degrees
telescopeOffset=13
# Nominal number of spatial pixels in the long and short wavelength bands
numPixUpper=2048
numPixLower=2048
# Nominal number of column in a full scan
numCol=1230
# Angular sampling distance for long and short wavelength bands in radians
angularSamplingEW=1.23000e-04
angularSamplingNSUpper=4.1490e-05
angularSamplingNSLower=4.1490e-05
# Nominal instantaneous geometric field of view in radians
IGFOVew=129.2e-6
IGFOVns=41.49e-6
# Engineering term to weight individual tie points for binocular pairs in raidans
# Sets in accordance with INR error requirements for reference image
measWeight=28e-6
# Gyroscope angle random walk in radians/root(second) for Kalman Filter process noise
farrenkopf_e=0
farrenkopf_v=6.80387520069123e-07
farrenkopf_u=0
# The uncertainty in acceleration due to solar radiation pressure in km/s^2
srp_uncertainty=7e-11
# The scan mechanism shimming bias in radians
ewbias=3.599225
nsbias=0.09479
clockingbias=110e-6
# The 3-sigma ephemeris position error in km
ephPosErr=1.5
# The 3-sigma ephemeris velocity error in km/s
ephVelErr=2.5e-5
# Satellite attitude control steering method (targeted)
steeringMethod=2
# Targeted sterring parameters in degrees
steeringLat=0
steeringLon=-91
steeringRollBias=0
steeringPitchBias=0

# Rates of change allocated to Kalman Filter states for process noise
# States are ordered as they are documented in TEMPO-SER-4008
# Units are per second or radians/seconds
drift_roll=1e-9
drift_pitch=1e-9
drift_yaw=1e-9
drift_mag=1.16e-08
drift_misalign=0
drift_smile=0
drift_eflvar=0
drift_e0=0
drift_n0=0
drift_ke=1.16e-8
drift_xe=1.74e-8
drift_kee2=1.157e-7
drift_kne2=1.157e-7
drift_dx=0
drift_dy=1.1574e-11
drift_mag_diff=1.16e-08
drift_misalign_diff=0
drift_smilediff=0
drift_eflvardiff=0
drift_r1=0
drift_r2=0
drift_r3=0
drift_v1=0
drift_v2=0
drift_v3=0

# Random walk coefficients allocated to Kalman Filter states for process noise
# Units are per root(second) or radians/root(second)
randomWalkCoefficient_roll=1.111e-7
randomWalkCoefficient_pitch=1.111e-7
randomWalkCoefficient_yaw=1.111e-7
randomWalkCoefficient_mag=0
randomWalkCoefficient_misalign=0
randomWalkCoefficient_smile=0
randomWalkCoefficient_eflvar=0
randomWalkCoefficient_e0=0
randomWalkCoefficient_n0=0
randomWalkCoefficient_ke=0
randomWalkCoefficient_xe=0
randomWalkCoefficient_kee2=0
randomWalkCoefficient_kne2=0
randomWalkCoefficient_dx=0
randomWalkCoefficient_dy=0
randomWalkCoefficient_mag_diff=0
randomWalkCoefficient_misalign_diff=0
randomWalkCoefficient_smilediff=0
randomWalkCoefficient_eflvardiff=0
randomWalkCoefficient_r1=0
randomWalkCoefficient_r2=0
randomWalkCoefficient_r3=0
randomWalkCoefficient_v1=0
randomWalkCoefficient_v2=0
randomWalkCoefficient_v3=0

# Polarities of the DITs
north_dit_sense=-1
east_dit_sense=1

# Satellite position jumping limit in km
maxSatPosJump=1.5

## Gyroscope configuration
[Gyroscope]
# The number of gyro axes. Default to 4
numGyroAxes = 4
# Set the value to 1 if the axis is enabled, 0 if the axis is disabled. Default to true(1).
axisEnabledFlag_0 = 1
axisEnabledFlag_1 = 1
axisEnabledFlag_2 = 1
axisEnabledFlag_3 = 0

# Analog-to-Digital representation of LSB in radians
lsb = 0.0037876e-6

# Number of bits in Gyroscope output
numBits = 24

# Number of elements in the matrix for sensing axes in IRU frame
# Should be 3 * number of elements in gyro output
numSensingElements = 12

# Number of scale factor
# Should be the same as number of elements in gyro output
numScaleFactors = 4

# Scale factor
scaleFactor_0 = 0
scaleFactor_1 = 0
scaleFactor_2 = 0
scaleFactor_3 = 0
# Each element in the sensing matrix in row major order
sensingElement_0 = 0.600164
sensingElement_1 = 0.551662
sensingElement_2 = 0.579200
sensingElement_3 = 0.598222
sensingElement_4 = -0.601944
sensingElement_5 = 0.528955
sensingElement_6 = -0.555617
sensingElement_7 = -0.601944
sensingElement_8 = 0.573545
sensingElement_9 = -0.553675
sensingElement_10 = 0.551662
sensingElement_11 = 0.623789

# Gyroscope Calibration in rad/s
# For dates prior to 8/17:
#axisCalibration_0 = 0.053523430394493e-6
#axisCalibration_1 = 0.053523430394493e-6
#axisCalibration_2 = -0.071364573859324e-6
#axisCalibration_3 = -0.169490862915894e-6
# For dates after sunrise 8/18:
axisCalibration_0 = 0.0
axisCalibration_1 = 0.0
axisCalibration_2 = 0.0
axisCalibration_3 = 0.0

## Earth orientation data

[oi]

# Directory for IERS Bulletin A
IERSDirectory=@INR_IERS_DIR@
# Notification alarm threshold in days, alarm raised if expiration is this close
UT1UTCTimeout=10

## Parameters that control the operation of the Kalman Filter-Smoother
## States are ordered as they are documented in TEMPO-SER-4008 and are unitless or in radians

[filter]

# The number of hours (That has tiepoint measurement) in training mode. In training mode,
# the tiepoints are not edited based on n-signa criteria, nor norm of residual
numHoursInTraining=1

# The minimum number of TiePoints needed to update the Kalman Filter
minNumTPs=2

# Assumed cloud-top height for cloudy monocular tie points in km
nominalCloudHeight=3

# Use of monocular tie points in absence of binocular ones (USE_BOTH USE_LEFT USE_RIGHT USE_NONE)
useMonocular=USE_RIGHT

# Lags for the Smoother in scans, set to zero to smooth at scan completion with nominal OPSCON
nlags=0

# The uncertainties for the TiePoints
# These values are (20.0e-6)^2 to estimate tie-point accuracy
RTieBothEW = 4.0e-10
RTieBothNS = 4.0e-10
RTieLeftEW = 4.0e-10
RTieLeftNS = 4.0e-10
RTieRightEW = 4.0e-10
RTieRightNS = 4.0e-10

# Fraction of tie points to reserve as witnesses for INR error and not be used in Kalman Filter
ReservedMeasurementsRatio=0.05
# Editing threshold for tie points, discards if norm(residual) > limit
ResidualThreshold=500e-06
# Editing n-sigma criteria for tie points, discards if norm(residual)>n*sigma(sample)
MaxMeasurementSigma=3.8

# Finite difference deltas for sensitivity matrices
# States are not solved for if zero; otherwise it is not recommended to change these values
delta_roll=1e-3
delta_pitch=1e-3
delta_yaw=1e-3
delta_magnification=1e-03
delta_misalignment=0
delta_smile=0
delta_eflvar=0
delta_e0=0
delta_n0=0
delta_ke=0
delta_xe=0
delta_kee2=0
delta_kne2=0
delta_dx=0
delta_dy=0
delta_magdiff=0
delta_misaligndiff=0
delta_smilediff=0
delta_eflvardiff=0
delta_r1=1e-3
delta_r2=1e-3
delta_r3=1e-3
delta_v1=1e-3
delta_v2=1e-3
delta_v3=1e-3

# Initial state for cold-start of Kalman Filter
init_state_roll=0
init_state_pitch=0
init_state_yaw=0
init_state_magnification=7.92e-3
init_state_misalignment=0
init_state_smile=3.4e-6
init_state_eflvar=3.367e-7
init_state_e0=0
init_state_n0=0
init_state_ke=-7.5e-3
init_state_xe=0
init_state_kee2=0
init_state_kne2=2e-2
init_state_dx=0
init_state_dy=-5.5e-6
init_state_magdiff=0
init_state_misaligndiff=0
init_state_smilediff=0
init_state_eflvardiff=0
init_state_r1=0
init_state_r2=0
init_state_r3=0
init_state_v1=0
init_state_v2=0
init_state_v3=0

# Initial state covariance diagonal one-sigma values for cold-start of Kalman Filter
init_cov_roll=1.0e-08
init_cov_pitch=1.0e-08
init_cov_yaw=1.0e-08
init_cov_magnification=4.4444e-07
init_cov_misalignment=0
init_cov_smile=0
init_cov_eflvar=0
init_cov_e0=0
init_cov_n0=0
init_cov_ke=4.4444e-05
init_cov_xe=4.4444e-05
init_cov_kee2=4.4444e-03
init_cov_kne2=4.4444e-03
init_cov_dx=0
init_cov_dy=4.67e-11
init_cov_magdiff=4.4444e-05
init_cov_misaligndiff=0
init_cov_smilediff=0
init_cov_eflvardiff=0
init_cov_r1=2.25e-11
init_cov_r2=2.25e-11
init_cov_r3=2.25e-11
init_cov_v1=1.18e-12
init_cov_v2=1.18e-12
init_cov_v3=1.18e-12

# maximum idle seconds for the granules before triggering a warm restart. Default to 1200 seconds (20 minutes)
maxIdleSecs=1200

## File with the JPL planetary ephemeris data

[jplephem]

filename=@INR_REFDATA_DIR@/jpleph2000-2060.dat

## File for logs and directory for alarms

[Logging]

filename=@INR_PROCESSING_ROOT@/logs/tempo_ui.log
alarmDir=@INR_PROCESSING_ROOT@/logs/

## Parameters for controlling the performance evaluation

[Performance]
# Max Earth Central Angle in degrees beyond which data is not included in evaluation
ECA=60.0
# Max Solar Zenith Angle in degrees beyond which data is not included in evaluation
SZA=70.0
# Effective Instantaneous Field of View in radians for spatial sampling uniformity and gaps
EIFOVx=129.2e-6
EIFOVy=41.49e-6
# Effective sigma limit for Median Absolute Difference filtering to cull outlier points
SigmaLimit=4
# Spec limits for the geolocation error
GeolocationErrorReq=82.0

# 3-Sigma geolocation error Requirement in microradians
Requirement=82

# Requirement of E/W sampling uniformity requirement in microradians
SamplingUniformityReqEW=12

# Requirement of N/S sampling uniformity requirement in microradians
SamplingUniformityReqNS=4.2

## Orientation of the TEMPO optical boresight along the roll (x), pitch (y), yaw (z) axes
## TODO item after Host integration is to finalize this unit vector

[Boresight]

orientation_x=0.004563
orientation_y=-0.094710
orientation_z=0.995494

## Text file with Greater North America latitudes and longitudes in degrees
## This is used to test compliance with coverage requirements, and it is a
## TODO item to finalize defintion of the GNA polygon

[GNA]

filename=@INR_REFDATA_DIR@/GNA.txt

## Parameters for controlling the Cloud Classification Function
## Classification algorithm is documented in "Color-Space Cloud Classifier", 9/18/16

[CloudMask]

# Saturation and intensity thresholds in a Hue-Saturation-Intensity (HSI) color space
saturation=0.22
intensity=0.32
# Solar zenith angle limit in degrees (if larger, no classification)
sza_max=80
# Red band construction: min and max wavelengths in nm
red_min_spectral=657.5
red_max_spectral=686.0
# Red band white balancing factor
red_factor=11.9402
#red_factor=4.0378e+28
# Green band construction: min and max wavelengths in nm
green_min_spectral=550.0
green_max_spectral=575.5
# Red band white balancing factor
green_factor=12.0595
#green_factor=3.4164e+28
# Blue band construction: min and max wavelengths in nm
blue_min_spectral=450.0
blue_max_spectral=471.0
# Blue band white balancing factor
blue_factor=12.0542
#blue_factor=2.7944e+28

## Parameters for controlling the Scan Tailoring Function

[ScanTailoring]

# Target latitude and longitude for the center of the Field of Regard in degrees
# TODO item is to adjust to match MRD spec when Host station is known
target_lat=33.5231
target_lon=-89.2170
# Maximum period for Fourier model of repeating attitude offsets in hours
num_hours_per_period=24
# Number of roll, pitch, and yaw states to use in model fitting each granule
#samples_per_granule=1
samples_per_granule=4
# Order of the Fourier model for each attitude state
# TODO item is to adjust in orbit
fourier_terms_roll=4
fourier_terms_pitch=4
fourier_terms_yaw=4
# The threshold of fitting R squared to calculate scan tailoring coefficients. Default to 0.7
minRsquared=0.6

# The directory where the planning ephemeris files are located
ephemerisDir=@SDPC_ANCILLARY_ROOT@/var/host/ephemeris
# The regular expression for filename to determine whether the file is a ephemeris file
ephemerisRegex=^tempo_d(\d{5})m(\d{8})u(\d{3})_(p\d{5}_)*r(\d{1})_ephemeris.csv$
# The interval between elements in ephemeris files, in seconds
ephemerisInterval=600
# The directory where the ScanTailoring coefficient files are being written to
fileDir=@INR_PROCESSING_ROOT@/scantailoring/
# The interval between calculating adjacent predicted states, in seconds
prediction_interval=900
# The number of days ahead to calculate the predicted states
prediction_days=14

## Parameters for getting altitude data from lookup file

[Altitude]

# filename for the lookup file
filename=@INR_REFDATA_DIR@/Ellipsoid_Altitude_Map.nc
