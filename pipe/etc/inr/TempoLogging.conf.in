##
## @file TempoLogging.conf
##
## Official logging configuration for the TEMPO Pipeline.
##
## @author Kerrie Allen : kallen@carrastro.com
## @version kallen: 20 Oct 2014: Initial coding.
##

--default
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/%datetime{%Y%M%d}_master.log"
   ENABLED              =  true
   TO_FILE              =  true
   TO_STANDARD_OUTPUT   =  true
   MILLISECONDS_WIDTH   =  6
   PERFORMANCE_TRACKING =  true

* TRACE:
   ENABLED              =  false
*INFO:
   ENABLED              =  true
* DEBUG:
    ENABLED             =  false
* WARNING:
    ENABLED             =  true
*ERROR:
    ENABLED             =  true
*FATAL:
   ENABLED              =  true

--store
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/store.log"
   ENABLED              =  false
   TO_FILE              =  false
   TO_STANDARD_OUTPUT   =  false
* TRACE:
   ENABLED              =  false
* INFO:
   ENABLED              =  false
* DEBUG:
   ENABLED              =  false

--pipeline
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/%datetime{%Y%M%d}_pipeline.log"
   ENABLED              =  true
   TO_FILE              =  true
   TO_STANDARD_OUTPUT   =  false
* TRACE:
   ENABLED              =  false
* INFO:
   ENABLED              =  true
* DEBUG:
   ENABLED              =  false

--processing
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/processing.log"
   ENABLED              =  false
   TO_FILE              =  false
   TO_STANDARD_OUTPUT   =  false
* TRACE:
   ENABLED              =  false
* INFO:
   ENABLED              =  false
* DEBUG:
   ENABLED              =  false

--filter
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/%datetime{%Y%M%d}_filter.log"
   ENABLED              =  true
   TO_FILE              =  true
   TO_STANDARD_OUTPUT   =  false
* TRACE:
   ENABLED              =  false
* INFO:
   ENABLED              =  true
* DEBUG:
   ENABLED              =  false

--external
* GLOBAL:
   FORMAT               =  "%datetime %level %msg"
   FILENAME             =  "@INR_PROCESSING_ROOT@/logs/external.log"
   ENABLED              =  false
   TO_FILE              =  false
   TO_STANDARD_OUTPUT   =  false
* TRACE:
   ENABLED              =  false
* INFO:
   ENABLED              =  false
* DEBUG:
   ENABLED              =  false
