#!/bin/sh

exec 2>& 1

if test -z "${SDPC_ROOT}"
then
  echo "The SDPC environment is not set"
  exit 1
fi

. "$SDPC_ROOT/etc/iocpull.rc"

if ! test -d $sdpc_dest_dir ; then
  mkdir -p $sdpc_dest_dir
fi

echo "iocpull $ioc_src_dir -> $sdpc_dest_dir"

exec move_file_stream.sl $ioc_src_dir $sdpc_dest_dir
