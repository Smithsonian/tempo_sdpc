# -*- sh -*-

include ../../Makefile.defines

#---------------------------------------------------------------------------
# List of modules and associated .sl files to install
#---------------------------------------------------------------------------
MODULES =# daemon-module.so
SL_FILES = pipeutil.sl
SETUP_SCRIPT_FILES = inr_mkdirs.sh inr_config.sh \
                     pipe_mkdirs_archive.sh pipe_mkdirs_master.sh \
		     pipe_mkdirs_node.sh pipe_setup_master.sh \
		     pipe_setup_nodes.sh mock_feed.sh
SCRIPT_FILES = cachemon.sl archive.sl move_file_stream.sl o3p_partition.sl \
               sdpcrun.sh make_tar_notice.sh \
               select_hk.py select_irr.py select_dark.py register.py  \
               insert_fixed_metadata.py fix_cldo4_metadata.py fix_met_format.py \
               copy_level1_frame.py radiance_inr_status.py \
               asdc_mkscript.sl asdc_track_uploads.py asdc_push.sh asdc_pull.sh \
               sdpccron.py update_public_mirror.sh inrmonitor.sh \
               $(patsubst %.sh,../setup/%.sh, $(SETUP_SCRIPT_FILES))
ETC_FILES = $(shell grep -v '\#' ../etc/etc_files.lis)
HLP_FILES =# ../doc/help/daemon.hlp
DOC_FILES = ../COPYRIGHT ../README #../doc/text/daemon.txt
MODULE_VERSION	= `./mkversion.sh`

#---------------------------------------------------------------------------
# Installation Directories
#---------------------------------------------------------------------------
prefix = @prefix@
exec_prefix = @exec_prefix@
datarootdir = @datarootdir@
MODULE_INSTALL_DIR = @MODULE_INSTALL_DIR@
SL_FILES_INSTALL_DIR = @SL_FILES_INSTALL_DIR@
SCRIPT_FILES_INSTALL_DIR = $(prefix)/bin
ETC_FILES_INSTALL_DIR = $(prefix)/etc
HLP_FILES_INSTALL_DIR = $(SL_FILES_INSTALL_DIR)/help
DOC_FILES_INSTALL_DIR =# $(datarootdir)/doc/slang-daemon

#---------------------------------------------------------------------------
# C Compiler to create a shared library
#---------------------------------------------------------------------------
#CC		= @CC@
#CFLAGS		= @CFLAGS@ @SLANG_DLL_CFLAGS@
#LDFLAGS	= @LDFLAGS@
#CC_SHARED 	= @CC_SHARED@
CC_SHARED       = $(CC) $(CFLAGS) -shared -fPIC

#---------------------------------------------------------------------------
# Location of the S-Lang library and its include file
#---------------------------------------------------------------------------
SLANG_INC	= @SLANG_INC@
SLANG_LIB	= @SLANG_LIB@ -lslang

#---------------------------------------------------------------------------
# Additional Libraries required by the module
#---------------------------------------------------------------------------
#RPATH		= @RPATH@
MODULE_LIBS	= $(TELL_LIB)

TELL_INC        = -I@TELL_INC@
TELL_LIB        = -L@TELL_LIB@ -ltell

#---------------------------------------------------------------------------
# Misc Programs required for installation
#---------------------------------------------------------------------------
INSTALL		= @INSTALL@
INSTALL_DATA	= @INSTALL_DATA@
INSTALL_MODULE	= @INSTALL_MODULE@
MKINSDIR	= ../../autoconf/mkinsdir.sh
RM		= rm -f
LN		= ln -s

#---------------------------------------------------------------------------
# DESTDIR is designed to facilitate making packages.  Normally it is empty
#---------------------------------------------------------------------------
DESTDIR =
DEST_MODULE_INSTALL_DIR = $(DESTDIR)$(MODULE_INSTALL_DIR)
DEST_SL_FILES_INSTALL_DIR = $(DESTDIR)$(SL_FILES_INSTALL_DIR)
DEST_SCRIPT_FILES_INSTALL_DIR = $(DESTDIR)$(SCRIPT_FILES_INSTALL_DIR)
DEST_ETC_FILES_INSTALL_DIR = $(DESTDIR)$(ETC_FILES_INSTALL_DIR)
DEST_HLP_FILES_INSTALL_DIR = $(DESTDIR)$(HLP_FILES_INSTALL_DIR)
DEST_DOC_FILES_INSTALL_DIR = $(DESTDIR)$(DOC_FILES_INSTALL_DIR)

#---------------------------------------------------------------------------
LIBS = $(SLANG_LIB) $(MODULE_LIBS) $(RPATH) $(DL_LIB) -lm
INCS = $(SLANG_INC) $(TELL_INC)

srcdir = $(config_dir)/pipe/src
objdir = $(srcdir)/$(archobjs)
bindir = $(prefix)/bin

all: $(objdir) $(MODULES) $(objdir)/filedb

#---------------------------------------------------------------------------
# Put Rules to create the modules here
#---------------------------------------------------------------------------
#daemon-module.so: daemon-module.c
#	$(CC_SHARED) $(INCS) daemon-module.c -o daemon-module.so $(LIBS)

COMPILE_CMD = $(CC) $(CCFLAGS)
ELF_COMPILE_CMD = $(ELF_CC) -c $(ELF_CFLAGS)

TIO_INC = $(config_dir)/libtio/src
TIO_LIB = $(config_dir)/libtio/src/$(archobjs)

TIO_LIBPATHS  = -Wl,-rpath=$(TIO_LIB) -L$(TIO_LIB)
LIBCONFIG_LIBPATHS = -Wl,-rpath=$(LIBCONFIG_LIB) -L$(LIBCONFIG_LIB)

IOCSDPC_INC = $(prefix)/include
IOCSDPC_LIBPATHS = -Wl,-rpath=$(prefix)/lib -L$(prefix)/lib -lioclib -lcsv

FILEDB_OFILES = filedb.o filedb_met.o filedb_snow.o filedb_tempo.o
FILEDB_OBJS = $(patsubst %.o,$(objdir)/%.o, $(FILEDB_OFILES))

FILEDB_LIBS = $(TIO_LIBPATHS) -ltio $(LIBCONFIG_LIBPATHS) -lconfig $(IOCSDPC_LIBPATHS)
FILEDB_INC_DIRS = $(TIO_INC) $(LIBCONFIG_INC) $(IOCSDPC_INC)
FILEDB_INCS = $(patsubst %,-I%, $(FILEDB_INC_DIRS))

$(objdir):
	-mkdir -p $(objdir)

$(objdir)/filedb:	$(FILEDB_OBJS)
	$(COMPILE_CMD) -o $(objdir)/filedb $(FILEDB_OBJS) \
	    $(FILEDB_INCS) $(FILEDB_LIBS) -lm

$(objdir)/filedb.o:	$(srcdir)/filedb.c
	cd $(objdir) && $(ELF_COMPILE_CMD) $(FILEDB_INCS) $(srcdir)/filedb.c $(FILEDB_LIBS)

$(objdir)/filedb_met.o:	$(srcdir)/filedb_met.c
	cd $(objdir) && $(ELF_COMPILE_CMD) $(FILEDB_INCS) $(srcdir)/filedb_met.c $(FILEDB_LIBS)

$(objdir)/filedb_snow.o:	$(srcdir)/filedb_snow.c
	cd $(objdir) && $(ELF_COMPILE_CMD) $(FILEDB_INCS) $(srcdir)/filedb_snow.c $(FILEDB_LIBS)

$(objdir)/filedb_tempo.o:	$(srcdir)/filedb_tempo.c
	cd $(objdir) && $(ELF_COMPILE_CMD) $(FILEDB_INCS) $(srcdir)/filedb_tempo.c $(FILEDB_LIBS)

# $(objdir)/filedb_ephemeris.o:	$(srcdir)/filedb_ephemeris.c
# 	cd $(objdir) && $(ELF_COMPILE_CMD) $(FILEDB_INCS) $(srcdir)/filedb_ephemeris.c $(FILEDB_LIBS)

#---------------------------------------------------------------------------
# Installation Rules
#---------------------------------------------------------------------------
install_directories:
	$(MKINSDIR) $(DEST_MODULE_INSTALL_DIR)
	$(MKINSDIR) $(DEST_SL_FILES_INSTALL_DIR)
	$(MKINSDIR) $(DEST_SCRIPT_FILES_INSTALL_DIR)
	$(MKINSDIR) $(DEST_ETC_FILES_INSTALL_DIR)/trace_gas
	$(MKINSDIR) $(DEST_ETC_FILES_INSTALL_DIR)/cloud
	$(MKINSDIR) $(DEST_ETC_FILES_INSTALL_DIR)/o3_total
	$(MKINSDIR) $(DEST_ETC_FILES_INSTALL_DIR)/o3_profile
	$(MKINSDIR) $(DEST_ETC_FILES_INSTALL_DIR)/level1
	$(MKINSDIR) $(DEST_ETC_FILES_INSTALL_DIR)/level3
	$(MKINSDIR) $(DEST_ETC_FILES_INSTALL_DIR)/inr
	$(MKINSDIR) $(DEST_ETC_FILES_INSTALL_DIR)/metadata
	#$(MKINSDIR) $(DEST_HLP_FILES_INSTALL_DIR)
	#$(MKINSDIR) $(DEST_DOC_FILES_INSTALL_DIR)

install_execs:
	mkdir -p $(bindir)
	@echo installing executables in $(bindir)/
	$(INSTALL_PROGRAM) $(objdir)/filedb $(bindir)/

install_modules:
	@for X in $(MODULES); \
	do \
		Y=$$X.$(MODULE_VERSION); \
		YDEST=$(DEST_MODULE_INSTALL_DIR)/$$Y; \
		echo $(INSTALL_MODULE) $$X $$YDEST; \
		$(INSTALL_MODULE) $$X $$YDEST; \
		if [ "$$?" != "0" ]; then \
		  exit 1; \
		fi; \
		$(RM) $(DEST_MODULE_INSTALL_DIR)/$$X; \
		$(LN) $$Y $(DEST_MODULE_INSTALL_DIR)/$$X; \
	done

install_scripts:
	@for X in $(SCRIPT_FILES); \
	do \
		echo $(INSTALL) $$X $(DEST_SCRIPT_FILES_INSTALL_DIR); \
		$(INSTALL) $$X $(DEST_SCRIPT_FILES_INSTALL_DIR); \
		if [ "$$?" != "0" ]; then \
		  exit 1; \
		fi; \
	done

install_supervision_tree:
	/bin/cp -r ../etc/services $(DEST_ETC_FILES_INSTALL_DIR)

install_etcfiles:
	@for X in $(ETC_FILES); \
	do \
		echo $(INSTALL_DATA) ../etc/$$X $(DEST_ETC_FILES_INSTALL_DIR); \
		$(INSTALL_DATA) ../etc/$$X $(DEST_ETC_FILES_INSTALL_DIR)/$$X; \
		if [ "$$?" != "0" ]; then \
		  exit 1; \
		fi; \
	done

install_slfiles:
	@for X in $(SL_FILES); \
	do \
		echo $(INSTALL_DATA) $$X $(DEST_SL_FILES_INSTALL_DIR); \
		$(INSTALL_DATA) $$X $(DEST_SL_FILES_INSTALL_DIR); \
		if [ "$$?" != "0" ]; then \
		  exit 1; \
		fi; \
	done
install_hlpfiles:
	@for X in $(HLP_FILES); \
	do \
		echo $(INSTALL_DATA) $$X $(DEST_HLP_FILES_INSTALL_DIR); \
		$(INSTALL_DATA) $$X $(DEST_HLP_FILES_INSTALL_DIR); \
		if [ "$$?" != "0" ]; then \
		  exit 1; \
		fi; \
	done
install_docfiles:
	@for X in $(DOC_FILES); \
	do \
		echo $(INSTALL_DATA) $$X $(DEST_DOC_FILES_INSTALL_DIR); \
		$(INSTALL_DATA) $$X $(DEST_DOC_FILES_INSTALL_DIR); \
		if [ "$$?" != "0" ]; then \
		  exit 1; \
		fi; \
	done

install: all install_directories install_modules install_execs \
          install_scripts install_etcfiles install_slfiles \
          install_supervision_tree # install_hlpfiles install_docfiles

clean:
	-/bin/rm -f $(MODULES) $(objdir)/*
distclean: clean
	-/bin/rm -f config.h Makefile
