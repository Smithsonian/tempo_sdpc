#
# The points day_beg, day_end may differ from scan_beg, scan_end
# because checking the SZA at the FOR scan limits may not
# the best way to gauge the illumination across an entire granule.
# Also, using a single sample point is cheaper than computing
# the SZA over a fine grid of points spanning an entire granule.

scan_config: {

# scan_beg, scan_end are the eastern and western limits of the scan:

  scan_beg: {lon =  -73.71; lat = 18.0;};
  scan_end: {lon = -126.40; lat = 18.0;};
 #scan_beg: {lon =  -87.623; lat = 41.881;};  # Chicago
 #scan_end: {lon = -104.673; lat = 39.849;};  # Denver

# day_beg, day_end are control points used to decide what time
# interval is best for performing radiance scans with sza<max_sza.

  day_beg: {lon =  -71.057; lat = 42.361;};  # Boston
  day_end: {lon = -122.431; lat = 37.774;};  # San Francisco
 #day_beg: {lon =  -87.623; lat = 41.881;};  # Chicago
 #day_end: {lon = -104.673; lat = 39.849;};  # Denver

# Mirror stepping parameters:

  step_config: {
     scan_reset  = 2.35;
     scan_timing_margin = 52.51083872;
     integration_time = 0.118;
     num_coadds = 21;
     frame_transfer_time = 0.00833328;
     readout_time = 0.1;
  };
};

limits_config: {

# max_sza = maximum useful solar zenith angle
  max_sza = 80.0;

# min_sun_angle = minimum safe angle between the
#                 sun and boresight directions
  min_sun_angle = 60.0;
};

master_table_config: {

  # step_size refers to the azimuthal coordinate in the field of regard.
  # The +X direction is eastward. For the mirror, +Y is southward,
  # so a right- handed coordinate system has +Z along the boresight
  # direction. roll_angle > 0 is clockwise rotation of a vector
  # in the FOR about the boresight (+Z) axis.
  # step_size and roll_angle are in microradians.
  #
  # step_size<0 represents a westward step.
  # For example, roll_angle>0 will move the eastern end of the
  # scan track to a +Y coordinate, making mirror_y>0 at
  # the eastern edge of the FOR.

  step_size = -114.0;
  roll_angle = 0.0;
};

sat_config: {

# sat_lon = geostationary satellite longitude
  sat_lon = -100.0;

# instrument boresight surface coordinates:
  boresight: {lon = -97.0, lat = 34.0;};
};

iers_config: {

# Values of these parameters, accurate for the current date, can be
# obtained from IERS Bulletin A, available from:
# https://www.iers.org/IERS/EN/Publications/Bulletins/bulletins.html
# ut1_utc = predicted UT1-UTC [sec]

  xpole = 0.0;
  ypole = 0.0;
  ut1_utc = 0.494792
};

novas_config: {
  ephem_name = "/vex/d2/tempo/install/gnu/share/libnovas/JPLEPH";
};

output_sza_map_config: {

# SZA image dimension
   img_size = 256;

# dimensions of nominal field of regard and
# pixel angular size [microradian] in each dimension

   num_mirror_steps   = 1283;
   size_mirror_step   = 114.0;

   num_xtrack         = 2038;
   size_xtrack_pixel  = 41.79;

# tilt>0 [deg] is northward tilt of instrument boresight,
#              about spacecraft roll axis
# azi>0 [deg] is rotation, eastward from north (CW),
#             about instrument boresight axis
# These angles specify the instrument pointing direction
# for the tilted perspective projection ('tpers') from
# the Proj4 library.

   tilt = 5.53
   azi  = 4.5
};
